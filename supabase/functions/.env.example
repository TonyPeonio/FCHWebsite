# Local development secrets for `supabase functions serve` (copy to functions/.env).
# In production set these with `supabase secrets set NAME=value` instead.
SITE_URL=http://localhost:5173
OFFICE_EMAIL=firstchoicehomesllc@yahoo.com
# Cloudflare's documented always-pass test secret; use the real secret in production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Local Mailpit (started by `supabase start`); leave unset in production and set RESEND_API_KEY.
MAILPIT_URL=http://supabase_inbucket_FCHWebsite:8025
# Browser-reachable API URL for links in emails (local only; production uses SUPABASE_URL).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
